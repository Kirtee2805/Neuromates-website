# ====================================================================
# NEURO MATES — Git Ignore (.gitignore)
# ====================================================================

# Environment Variables & Secret Credentials
.env
.env.local
.env.*.local
*.pem
*.key

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment Folders
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Vector Embeddings & Cache
*.pkl
*.pickle
*.index
*.faiss
.cache/
.pytest_cache/

# Operating System & IDE Files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# Logs
*.log
logs/

