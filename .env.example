# ====================================================================
# NEURO MATES — Environment Configuration Example
# Copy this file to .env and configure your production values
# ====================================================================

# Server Port
PORT=3000

# PostgreSQL Database Configuration
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_secure_password
PGDATABASE=neuromates

# SMTP / Email Notification Configuration (via nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@neuromates.example.com
SMTP_PASS=your_smtp_password
NOTIFICATION_EMAIL=clinical-team@neuromates.example.com

# Node Environment
NODE_ENV=development

